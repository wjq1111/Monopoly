; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]
config/name="我们的家"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="三只猫的故事。三名玩家，系统自动主持。"

[display]
window/size/viewport_width=1100
window/size/viewport_height=760
window/size/window_width_override=1100
window/size/window_height_override=760
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.086, 0.094, 1)
